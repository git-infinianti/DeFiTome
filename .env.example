# DeFiTome Environment Variables

# API Keys
INFURA_API_KEY=your_infura_api_key_here
ALCHEMY_API_KEY=your_alchemy_api_key_here
ETHERSCAN_API_KEY=your_etherscan_api_key_here

# Network Configuration
NETWORK=mainnet
RPC_URL=https://mainnet.infura.io/v3/YOUR_INFURA_KEY

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/defitome
MONGODB_URI=mongodb://localhost:27017/defitome

# Application
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# Wallet Configuration
PRIVATE_KEY=your_private_key_here
WALLET_ADDRESS=your_wallet_address_here

# Third-party Services
JWT_SECRET=your_jwt_secret_key_here
REDIS_URL=redis://localhost:6379

# Smart Contracts
CONTRACT_ADDRESS=0x0000000000000000000000000000000000000000
TOKEN_ADDRESS=0x0000000000000000000000000000000000000000

# Feature Flags
ENABLE_ANALYTICS=true
ENABLE_NOTIFICATIONS=false

# Evrmore RPC Routing
DEFAULT_EVRMORE_NETWORK=testnet
DEFAULT_EVRMORE_RPC_ENDPOINT_MODE=public

# Public Evrmore RPC endpoints
EVRMORE_PUBLIC_RPC_MAINNET_URL=https://evr-rpc-mainnet.evrmorecoin.org/rpc
EVRMORE_PUBLIC_RPC_TESTNET_URL=https://evr-rpc-testnet.evrmorecoin.org/rpc

# Local/remote Evrmore node RPC (mainnet)
RPC_MAINNET_HOST=
RPC_MAINNET_PORT=
RPC_MAINNET_SCHEME=http
RPC_MAINNET_PATH=/rpc
RPC_MAINNET_URL=
RPC_MAINNET_USER=
RPC_MAINNET_PASSWORD=
RPC_MAINNET_DATADIR=/tmp/evrmore

# Local/remote Evrmore node RPC (testnet)
RPC_TESTNET_HOST=127.0.0.1
RPC_TESTNET_PORT=18819
RPC_TESTNET_SCHEME=http
RPC_TESTNET_PATH=/rpc
RPC_TESTNET_URL=
RPC_TESTNET_USER=
RPC_TESTNET_PASSWORD=
RPC_TESTNET_DATADIR=/tmp/evrmore

# RPC timeouts
RPC_TIMEOUT_SECONDS=10
RPC_PUBLIC_TIMEOUT_SECONDS=10
